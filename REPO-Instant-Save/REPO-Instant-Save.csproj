<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>REPO-Instant-Save</AssemblyName>
    <RootNamespace>REPO_Instant_Save</RootNamespace>
    <Product>REPO-Instant-Save</Product>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
    <!-- Suppress noisy nullable/obsolete warnings from un-annotated game assemblies -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <!-- Machine-specific paths. Edit these two if the game install or the active
       Thunderstore Mod Manager profile ever moves. Everything else derives from them. -->
  <PropertyGroup>
    <RepoGameDir>D:\Steam\steamapps\common\REPO</RepoGameDir>
    <RepoManaged>$(RepoGameDir)\REPO_Data\Managed</RepoManaged>
    <TsProfile>$(AppData)\Thunderstore Mod Manager\DataFolder\REPO\profiles\newPack</TsProfile>
    <BepInExCore>$(TsProfile)\BepInEx\core</BepInExCore>
    <BepInExPlugins>$(TsProfile)\BepInEx\plugins</BepInExPlugins>
    <DeployDir>$(BepInExPlugins)\Ashx87-REPO-Instant-Save</DeployDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" Version="2.2.1" PrivateAssets="all" />
  </ItemGroup>

  <!-- Publicize game assemblies so we can read/write private game state without reflection. -->
  <ItemGroup>
    <Publicize Include="Assembly-CSharp" />
    <Publicize Include="Assembly-CSharp-firstpass" />
  </ItemGroup>

  <ItemGroup>
    <!-- BepInEx / Harmony (provided at runtime; do not copy to output) -->
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Game code -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RepoManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(RepoManaged)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Unity -->
    <Reference Include="UnityEngine">
      <HintPath>$(RepoManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RepoManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(RepoManaged)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(RepoManaged)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RepoManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Photon (multiplayer / RPC) -->
    <Reference Include="PhotonUnityNetworking">
      <HintPath>$(RepoManaged)\PhotonUnityNetworking.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonRealtime">
      <HintPath>$(RepoManaged)\PhotonRealtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Photon3Unity3D">
      <HintPath>$(RepoManaged)\Photon3Unity3D.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Bundled with the game; used for snapshot (de)serialization. Not shipped. -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(RepoManaged)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Copy the built plugin into the active mod-manager profile after every build. -->
  <Target Name="DeployToPlugins" AfterTargets="Build">
    <MakeDir Directories="$(DeployDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pdb" DestinationFolder="$(DeployDir)" SkipUnchangedFiles="false" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
    <Message Importance="high" Text="[REPO-Instant-Save] Deployed $(AssemblyName).dll -> $(DeployDir)" />
  </Target>

</Project>
